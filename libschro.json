{
    "name": "libschro",
    "version": "1.0.2",
    "description": "Dirac video decoder",
    "filters":["diracdec"],
    "help": "This filter decodes raw Dirac elementary streams using schroedinger.",
    "support": [
        "video"
    ],
    "sources":"https://bevara.ddns.net/sources/libschro.accessor",
    "filter_source":{
        "diracdec" : "dec_dirac.c"
    },
    "extension":{
      "drc" : "video"
    },
    "using": ["mm_solver_1.0.1", "mm_solver_1.0.2", "mm_solver_1.0.3", "mm_solver_1.0.4"],
    "runtime": {
        "diracdec": {
            "outputs": [
                {
                    "property": "GF_PROP_PID_PIXFMT",
                    "format": [
                        "GF_PIXEL_YUV",
                        "GF_PIXEL_YUV422",
                        "GF_PIXEL_YUV444"
                    ]
                }
            ]
        }
    },
    "patents": {
        "status": "royalty-free",
        "note": "Dirac, royalty-free (BBC)",
        "checked": "2026-10-16"
    }
}
