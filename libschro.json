{
    "name": "libschro",
    "description": "Dirac video decoder",
    "filters":["diracdec"],
    "help": "This filter decodes raw Dirac elementary streams using schroedinger.",
    "support": [
        "video"
    ],
    "sources":"https://bevara.ddns.net/sources/libschro.accessor",
    "filter_source":{
        "diracdec" : "dec_dirac.c"
    },
    "extension":{
      "drc" : "video"
    },
    "licence_required":false,
    "using": ["solver_1"],
    "runtime": {
        "diracdec": {
            "outputs": [
                {
                    "property": "GF_PROP_PID_PIXFMT",
                    "format": [
                        "GF_PIXEL_YUV",
                        "GF_PIXEL_YUV422",
                        "GF_PIXEL_YUV444"
                    ]
                }
            ]
        }
    }
}
